# Локальный запуск. В облаке те же переменные задаёт .github/workflows/deploy.yml
# из секретов и переменных репозитория.
TELEGRAM_TOKEN=
DATABASE_URL=postgresql://postgres.<project>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
DB_SCHEMA=interior
WEBHOOK_SECRET=
WEBAPP_URL=https://<container>.containers.yandexcloud.net/
ALLOWED_ORIGINS=https://<container>.containers.yandexcloud.net
INIT_DATA_MAX_AGE_SECONDS=86400
# Пусто — api.telegram.org напрямую. Из Yandex Cloud — адрес ретранслятора + /tg.
TELEGRAM_API_BASE=
ADMIN_TELEGRAM_IDS=
